@using AudioAnalysis.Core.Models

<div class="key-feedback-wrap">
    @if (!isEditing && correctedKey == null)
    {
        <button class="btn-feedback" @onclick="() => isEditing = true" title="検出されたキーを修正">
            ✏️ 修正
        </button>
    }
    else if (isEditing)
    {
        <div class="feedback-editor">
            <select class="select feedback-select" @bind="selectedKey">
                <optgroup label="── 長調 (major) ──">
                    @foreach (var n in Notes)
                    {
                        <option value="@($"{n} major")">@n major</option>
                    }
                </optgroup>
                <optgroup label="── 短調 (minor) ──">
                    @foreach (var n in Notes)
                    {
                        <option value="@($"{n} minor")">@n minor</option>
                    }
                </optgroup>
            </select>
            <button class="btn-feedback-ok" @onclick="Confirm">✓ 確定</button>
            <button class="btn-feedback-cancel" @onclick="Cancel">✕</button>
        </div>
    }
    else if (correctedKey != null)
    {
        <div class="feedback-result">
            <span class="feedback-badge">修正済み</span>
            <span class="feedback-original" title="解析値">@DetectedKey</span>
            <span class="feedback-arrow">→</span>
            <span class="feedback-corrected">@correctedKey</span>
            <button class="btn-feedback-small" @onclick="Reset">↩</button>
        </div>
    }
</div>

@code {
    [Parameter] public string DetectedKey { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnCorrected { get; set; }

    private bool isEditing;
    private string? correctedKey;
    private string selectedKey = string.Empty;

    // 半音ごとに シャープ表記 → フラット表記 の順で並べる
    // 同じ音高でも記譜上の慣習が異なるため両方を選択できるようにする
    private static readonly string[] Notes =
    [
        "C",
        "C#", "D♭",
        "D",
        "D#", "E♭",
        "E",
        "F",
        "F#", "G♭",
        "G",
        "G#", "A♭",
        "A",
        "A#", "B♭",
        "B",
    ];

    private static readonly string[] AllKeys =
        Notes.Select(n => $"{n} major").Concat(Notes.Select(n => $"{n} minor")).ToArray();

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(selectedKey))
            selectedKey = DetectedKey;
    }

    private async Task Confirm()
    {
        correctedKey = selectedKey;
        isEditing = false;
        await OnCorrected.InvokeAsync(correctedKey);
    }

    private void Cancel() => isEditing = false;

    private void Reset()
    {
        correctedKey = null;
        selectedKey  = DetectedKey;
    }
}
